# Ensure Git hooks are executable
.git-hooks/* text eol=lf
.git-hooks/*.sh text eol=lf

# Force LF for files that run inside Linux containers.
# Without this, Git for Windows (default core.autocrlf=true) converts these
# to CRLF on checkout, which makes Linux fail to exec scripts with the
# misleading error "no such file or directory" (kernel sees shebang as
# "#!/bin/bash\r" and looks for an interpreter literally named "bash\r").
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

