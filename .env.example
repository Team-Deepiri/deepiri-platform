# ============================================================================
# Deepiri Platform - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in ALL required values.
# DO NOT commit the .env file to version control.
#
# Generate secure passwords with:
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# For External Bridge Service Google Client keys, use dummy placeholders.
# ============================================================================

# --- Environment ---
NODE_ENV=production

# --- External Bridge Service ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
EXTERNAL_BRIDGE_BASE_URL=http://external-bridge-service:5006
AUTH_SERVICE_URL=http://auth-service:5001

# --- PostgreSQL (cloud — postgres-platform) ---
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=deepiri_platform
PLATFORM_DB_PASSWORD=               # REQUIRED for cloud: openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                    # REQUIRED: openssl rand -base64 32
POSTGRES_DB=postgres

# --- PostgreSQL (control plane — deepiri-control-plane / docker-compose.dev.yml) ---
# Auth Database
POSTGRES_AUTH_DB=platform_auth
POSTGRES_AUTH_USER=deepiri_auth
POSTGRES_AUTH_PASSWORD=               # REQUIRED: openssl rand -base64 32

# Core Database
POSTGRES_CORE_DB=platform_core
POSTGRES_CORE_USER=deepiri_core
POSTGRES_CORE_PASSWORD=               # REQUIRED: openssl rand -base64 32

# Cyrex Database
POSTGRES_CYREX_DB=cyrex_db
POSTGRES_CYREX_USER=deepiri_cyrex
POSTGRES_CYREX_PASSWORD=              # REQUIRED: openssl rand -base64 32

# Intelligence Database (includes ML)
POSTGRES_INTELLIGENCE_DB=platform_intelligence
POSTGRES_INTELLIGENCE_USER=deepiri_intel
POSTGRES_INTELLIGENCE_PASSWORD=       # REQUIRED: openssl rand -base64 32

# --- Postgres Backups ---
BACKUP_RETENTION_DAYS=30              # local backups older than this get pruned
# Nightly dumps run inside `jobs` as `platform.pg_backup` (no pg-backup container).
PG_BACKUP_SCHEDULER_ENABLED=true
PG_BACKUP_CRON=0 2 * * *
# PG_BACKUP_HOST=postgres
# PG_BACKUP_DIR=/backups/postgres

# --- Postgres Backups: off-box sync (optional, disabled by default) ---
# Copies jobs `platform.pg_backup` output to S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, DO Spaces, MinIO, ...) via the pg-backup-offsite sidecar —
# see scripts/database/postgres-backup-offsite-sync.sh. Leave
# BACKUP_OFFSITE_ENABLED unset/false until a real bucket/account exists;
# everything else here is a no-op until then.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_PROVIDER=Other         # rclone provider hint: AWS/Cloudflare/Minio/Other
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ENDPOINT=              # required for non-AWS providers
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_PREFIX=postgres-backups

# --- Redis ---
REDIS_PASSWORD=                       # REQUIRED: openssl rand -base64 32

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=                      # REQUIRED: openssl rand -base64 16
MINIO_ROOT_PASSWORD=                  # REQUIRED: openssl rand -base64 32
MINIO_ACCESS_KEY=                     # REQUIRED: same as MINIO_ROOT_USER
MINIO_SECRET_KEY=                     # REQUIRED: same as MINIO_ROOT_PASSWORD

# --- InfluxDB ---
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=                    # REQUIRED: openssl rand -base64 32
INFLUXDB_ORG=deepiri
INFLUXDB_BUCKET=analytics
INFLUXDB_TOKEN=                       # REQUIRED: openssl rand -base64 48

# --- JWT ---
JWT_SECRET=                           # REQUIRED: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=              # REQUIRED: openssl rand -base64 32

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=               # REQUIRED: openssl rand -base64 24

# --- Cyrex API ---
CYREX_API_KEY=change-me               # Default for local dev, change for production

# --- Bedd (published GHCR image embedded into workers) ---
# Never retag a local build as this name — it shadows real pulls.
BEDD_IMAGE=ghcr.io/team-deepiri/bedd:0.8

# --- PrismPipe (Cyrex library only; no platform submodule or compose service) ---
# deepiri-prismpipe is pinned in diri-cyrex/pyproject.toml (git tag v0.2.1).

# --- Plaky (real API + headless bridge) ---
# Real API — read-only users/spaces/boards/items; key from https://app.plaky.com → Preferences → Advanced → Manage API keys
PLAKY_API_KEY=                           # plk_... (also accepted as PLAKY_API_TOKEN)
PLAKY_API_TOKEN=                         # alias for PLAKY_API_KEY
PLAKY_API_BASE=https://api.plaky.com/v1/public
# Headless bridge — 100% background, no GUI (requires browser automation)
# Set these to enable /plaky/invite and /plaky/kick automation via Playwright (headless: true)
PLAKY_EMAIL=                             # Plaky login email for bridge (headless browser)
PLAKY_PASSWORD=                          # Plaky login password (store in secrets only)
PLAKY_BRIDGE_URL=http://plaky-bridge:5009
PLAKY_BRIDGE_DATA_DIR=/app/data

# --- External APIs (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:3000
