# ============================================================================
# Deepiri Platform - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in ALL required values.
# DO NOT commit the .env file to version control.
#
# Generate secure passwords with:
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================

# --- Environment ---
NODE_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=deepiri
POSTGRES_PASSWORD=                    # REQUIRED: openssl rand -base64 32
POSTGRES_DB=deepiri

# --- PostgreSQL (Segmented) ---
# Auth Database
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=deepiri_auth
POSTGRES_AUTH_PASSWORD=               # REQUIRED: openssl rand -base64 32

# Core Database
POSTGRES_CORE_DB=deepiri
POSTGRES_CORE_USER=deepiri
POSTGRES_CORE_PASSWORD=               # REQUIRED: openssl rand -base64 32

# Cyrex Database
POSTGRES_CYREX_DB=cyrex_db
POSTGRES_CYREX_USER=deepiri_cyrex
POSTGRES_CYREX_PASSWORD=              # REQUIRED: openssl rand -base64 32

# Intelligence Database (includes ML)
POSTGRES_INTELLIGENCE_DB=intelligence_db
POSTGRES_INTELLIGENCE_USER=deepiri_intel
POSTGRES_INTELLIGENCE_PASSWORD=       # REQUIRED: openssl rand -base64 32

# --- MongoDB ---
MONGO_ROOT_USER=                      # REQUIRED: e.g. deepiri_admin
MONGO_ROOT_PASSWORD=                  # REQUIRED: openssl rand -base64 32
MONGO_DB=deepiri

# --- Redis ---
REDIS_PASSWORD=                       # REQUIRED: openssl rand -base64 32

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=                      # REQUIRED: openssl rand -base64 16
MINIO_ROOT_PASSWORD=                  # REQUIRED: openssl rand -base64 32
MINIO_ACCESS_KEY=                     # REQUIRED: same as MINIO_ROOT_USER
MINIO_SECRET_KEY=                     # REQUIRED: same as MINIO_ROOT_PASSWORD

# --- InfluxDB ---
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=                    # REQUIRED: openssl rand -base64 32
INFLUXDB_ORG=deepiri
INFLUXDB_BUCKET=analytics
INFLUXDB_TOKEN=                       # REQUIRED: openssl rand -base64 48

# --- JWT ---
JWT_SECRET=                           # REQUIRED: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=              # REQUIRED: openssl rand -base64 32

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=               # REQUIRED: openssl rand -base64 24

# --- Cyrex API ---
CYREX_API_KEY=change-me               # Default for local dev, change for production

# --- External APIs (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Boardman (GitHub + Plaky) ---
# Non-secret identifiers/routing
GITHUB_APP_ID=                        # REQUIRED for Boardman worker
GITHUB_INSTALLATION_ID=               # REQUIRED: numeric GitHub App installation id
GITHUB_ORG=                           # REQUIRED: e.g. Team-Deepiri
PLAKY_BASE_URL=https://api.plaky.com # REQUIRED unless your Plaky account uses another API base
PLAKY_WORKSPACE_ID=                   # REQUIRED
PLAKY_BOARD_ID=                       # REQUIRED
PLAKY_ITEM_GROUP_ID=                  # REQUIRED
PLAKY_FIELD_EXTERNAL_KEY_ID=          # REQUIRED
PLAKY_FIELD_GITHUB_URL_ID=            # REQUIRED
PLAKY_FIELD_REPO_ID=                  # REQUIRED
PLAKY_FIELD_STATUS_ID=                # REQUIRED
PLAKY_FIELD_PR_URL_ID=                # REQUIRED: Plaky link field for linked PR URL
PLAKY_FIELD_MERGE_STATE_ID=           # REQUIRED: Plaky status/select field for PR merge state
PLAKY_STATUS_OPEN_VALUE=              # REQUIRED: status key/title for open issues
PLAKY_STATUS_CLOSED_VALUE=            # REQUIRED: status key/title for closed issues
PLAKY_MERGE_STATE_OPEN_VALUE=         # REQUIRED: PR open
PLAKY_MERGE_STATE_MERGED_VALUE=       # REQUIRED: PR merged
PLAKY_MERGE_STATE_CLOSED_VALUE=       # REQUIRED: PR closed without merge
PLAKY_MERGE_STATE_DRAFT_VALUE=        # REQUIRED: PR draft
PLAKY_NEEDS_QA_STATUS=                # optional: status when PR is ready for review
PLAKY_IN_QA_STATUS=                   # optional: status when QA reviews/comments
PLAKY_PR_MERGE_STATUS=                # optional: status when PR merges
PLAKY_FIELD_QA_ASSIGNEE_ID=           # optional: Plaky people field for QA auto-assign
BOARDMAN_CONFIG_DIR=                  # optional: path to repos.yml + team_assignments.yml
BOARDMAN_PR_AUTO_LINK_THRESHOLD=0.5   # optional: fuzzy PR title match threshold

# Secrets (never commit real values)
GITHUB_APP_PRIVATE_KEY=               # REQUIRED: PEM content or mounted secret value
GITHUB_WEBHOOK_SECRET=                # REQUIRED: validates GitHub webhook signatures
PLAKY_API_KEY=                        # REQUIRED: Boardman service account key
ROUTE_SECRET=                         # REQUIRED: Boardman app route secret

# --- Frontend ---
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:3000
