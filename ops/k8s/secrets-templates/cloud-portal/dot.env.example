# Cloud portal root env — copy to ops/k8s/secrets/.env
# Fill from cloud-portal-secrets.7z (Discord). Never commit .env

NODE_ENV=production

# Postgres (single postgres-platform container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=deepiri_platform
PLATFORM_DB_PASSWORD=

# Shared service auth
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
REDIS_PASSWORD=

# Public URLs (set when DNS exists)
CORS_ORIGINS=https://portal.example.com
VITE_API_URL=https://portal.example.com/api
CLIENT_URL=https://portal.example.com

# OAuth (consult Josep for org Google project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External bridge / Plaky
EXTERNAL_BRIDGE_BASE_URL=https://portal.example.com/api/bridge
PLAKY_API_TOKEN=
PLAKY_POLL_INTERVAL_SEC=60

# Optional offsite backup sidecar
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_REGION=
