# Copy to ops/k8s/secrets/external-bridge-service-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: external-bridge-service-secret
  namespace: default
type: Opaque
stringData:
  REDIS_PASSWORD: "REPLACE_ME"
  GOOGLE_CLIENT_SECRET: "REPLACE_ME"
  PLAKY_API_TOKEN: "REPLACE_ME"
  # GitHub App for the People-page team-activity API.
  # App ID + installation ID from the App's settings / install URL.
  GITHUB_APP_ID: "REPLACE_ME"
  GITHUB_APP_INSTALLATION_ID: "REPLACE_ME"
  # PEM private key, base64 with no line wraps:  base64 -w0 app-private-key.pem
  GITHUB_APP_PRIVATE_KEY_BASE64: "REPLACE_ME"
  # Same string as the GitHub App's "Webhook secret" field. Leave blank to accept
  # webhook deliveries unverified (cache TTL still bounds staleness).
  GITHUB_WEBHOOK_SECRET: "REPLACE_ME"
