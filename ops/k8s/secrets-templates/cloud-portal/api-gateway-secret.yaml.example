apiVersion: v1
kind: Secret
metadata:
  name: api-gateway-secret
  namespace: default
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_ME"
  INTERNAL_SERVICE_SECRET: "REPLACE_ME"
  REDIS_PASSWORD: "REPLACE_ME"
  DB_PASSWORD: "REPLACE_ME_PLATFORM_DB_PASSWORD"
