# Copy to ops/k8s/secrets/auth-service-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: auth-service-secret
  namespace: default
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_ME"
  INTERNAL_SERVICE_SECRET: "REPLACE_ME"
  REDIS_PASSWORD: "REPLACE_ME"
  GOOGLE_CLIENT_SECRET: "REPLACE_ME"
